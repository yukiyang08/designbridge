# 必填
HF_TOKEN=
FAL_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 前端登入用（vite.config.js）
SUPABASE_ANON_KEY=

# LLM：專案根目錄有 service-account.json 就走 Vertex AI；沒有才用下面的 key
# GEMINI_API_KEY=
DESIGNBRIDGE_GEMINI_MODEL=gemini-3.6-flash

# 自架 GPU（Modal）：off（預設，全走 fal）| dev | demo，詳見 docs/MODAL_GPU.md
# DESIGNBRIDGE_MODAL_MODE=off

# 調參預設值都在 designbridge/core/config.py，要改再把對應的 DESIGNBRIDGE_* 加進來

# 選填：模型已快取到本機時，跳過 huggingface.co 連線檢查，加快啟動
# HF_HUB_OFFLINE=1
