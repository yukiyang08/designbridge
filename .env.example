#Required:
HF_TOKEN=***************
SUPABASE_URL=***************
SUPABASE_SERVICE_ROLE_KEY=***************

# 佈局 → 3D depth ControlNet（讓渲染遵守 2D 平面配置圖家具位置；需 fal-client）
FAL_KEY=***************
# DESIGNBRIDGE_ENABLE_LAYOUT_CONTROLNET=true
# DESIGNBRIDGE_FAL_DEPTH_CONTROLNET_MODEL=Shakker-Labs/FLUX.1-dev-ControlNet-Union-Pro
# DESIGNBRIDGE_FAL_DEPTH_CONTROL_MODE=depth      # Union control_mode 字串：canny|tile|depth|blur|pose|gray|low-quality
# 佈局控制：footprint canny(佔位) + 微俯視 depth(結構) 雙控制
# DESIGNBRIDGE_FAL_EDGE_CONDITIONING_SCALE=0.60  # 主控制：footprint 佔位(位置+大小)；忠實訊號，權重要夠高
# DESIGNBRIDGE_FAL_DEPTH_CONDITIONING_SCALE=0.22 # 次要：房間外殼/牆面結構（俯視角家具深度弱，故壓低）
# DESIGNBRIDGE_FAL_DEPTH_STEPS=42
# DESIGNBRIDGE_FAL_DEPTH_GUIDANCE=3.2
# 控制只作用於前段去噪步驟：結構早期定型，後段放手畫材質細節（降低全程強控導致的不合理）
# DESIGNBRIDGE_FAL_DEPTH_CONTROL_END=0.7         # depth 控制在 70% 步數後停止（1.0=全程）
# DESIGNBRIDGE_FAL_EDGE_CONTROL_END=0.75         # 邊緣(佔位)可撐久一點
# 家具用粗略語意剪影(床=平台+床頭板 / 沙發=座面+靠背+扶手 / 桌=桌面+桌腳)取代長方體
# DESIGNBRIDGE_ENABLE_SEMANTIC_SHAPES=true
# 近平視 look-at 相機（以下為預設值；調高 EYE_H/SETBACK 會變成俯視的娃娃屋視角，
# 調太低太近則貼近入口的家具會被切掉）
# DESIGNBRIDGE_LAYOUT_CAM_EYE_H=1.6              # 相機高度(m)
# DESIGNBRIDGE_LAYOUT_CAM_SETBACK=1.6            # 相機後退距離(m)
# DESIGNBRIDGE_LAYOUT_CAM_TARGET_H=0.9           # 對準點高度(m)
# DESIGNBRIDGE_LAYOUT_CAM_TARGET_DEPTH_FRAC=0.6  # 對準房間深度比例(0=前 1=後)
# DESIGNBRIDGE_LAYOUT_CAM_FOV=65
# LLM：call_llm 直連 Gemini
GEMINI_API_KEY=***************
# 多個 Gemini key（逗號分隔）；GEMINI_API_KEY quota 用完時全專案自動換下一把
# GEMINI_API_KEYS=key1,key2,key3
DESIGNBRIDGE_GEMINI_MODEL=gemini-3.6-flash
# 選填：GEMINI_API_KEY 失敗時依序換下一把（逗號分隔多組 key）
# GEMINI_API_KEYS=key2,key3,key4

# 選填：模型已快取到本機時，跳過 huggingface.co 的連線檢查（網路慢/不穩時可大幅加速啟動）
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# 選填：LLM provider（gemini | qwen | llama | vllm），預設 gemini
# vllm = AMD 端點（OpenAI 相容）；需先開 jump-host 通道：
#   ssh -i ~/.ssh/google_compute_engine -N -L 46351:210.61.209.139:46351 <帳號>@34.74.64.114
# DESIGNBRIDGE_LLM_PROVIDER=vllm
# DESIGNBRIDGE_VLLM_BASE_URL=http://localhost:46351/v1/
